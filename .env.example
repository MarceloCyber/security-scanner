# Database (será preenchido automaticamente pelo Railway)
APP_ENV=production
DATABASE_URL=postgresql://usuario:senha@host:5432/database

# Segurança
SECRET_KEY=replace-with-a-random-64-character-secret

# URLs
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Stripe (obtenha em: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_SEU_CODIGO_AQUI
STRIPE_PUBLISHABLE_KEY=pk_test_SEU_CODIGO_AQUI
STRIPE_WEBHOOK_SECRET=whsec_SEU_CODIGO_AQUI
# Price IDs opcionais. Se usados, o Starter deve ser recorrente mensal;
# Professional e Enterprise devem ser preços únicos com os valores vigentes.
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PROFESSIONAL=
STRIPE_PRICE_ID_ENTERPRISE=

# Mercado Pago (opcional; PIX/boleto ficam ocultos sem os dois valores)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Iron AI (use um provedor real; sem chave há fallback determinístico local)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_PROVIDER=groq
# Alternativa com camada gratuita para desenvolvimento: Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_CHAT_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_REASONING_EFFORT=low
# Para usar Kimi, troque AI_PROVIDER=kimi e configure uma conta Moonshot com cota.
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_CHAT_URL=https://api.moonshot.ai/v1/chat/completions
KIMI_REASONING_EFFORT=high

# Email (para reset de senha)
SMTP_HOST=SEU_SMTP_HOST
SMTP_PORT=SEU_SMTP_PORT
SMTP_USER=SEU_EMAIL_GMAIL
SMTP_PASSWORD=SEU_SENHA_GMAIL
FROM_EMAIL=SEU_EMAIL_GMAIL
FROM_NAME=Iron AI

# Infraestrutura opcional
REDIS_URL=redis://localhost:6379/0
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
